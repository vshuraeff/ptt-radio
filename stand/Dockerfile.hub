# ptt-radio-hub for the stand; build context is ../companion (see compose.hub.yaml)
# the companion uses let chains on edition 2024, so the toolchain must be 1.88 or newer
FROM rust:1.99-slim-bookworm AS build
# cmake (driving make) builds the bundled libopus; cpal, in the library the hub links, needs alsa headers
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake make pkg-config libasound2-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# the whole crate, experiments included: cargo resolves the path dev-dependency
COPY . .
RUN cargo build --locked --release --bin ptt-radio-hub

FROM debian:bookworm-slim
# libasound may stay a dynamic dependency of the linked library even though the hub plays nothing
RUN apt-get update \
 && apt-get install -y --no-install-recommends libasound2 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --no-create-home hub
COPY --from=build /src/target/release/ptt-radio-hub /usr/local/bin/ptt-radio-hub
USER hub
EXPOSE 34560/udp
ENTRYPOINT ["/usr/local/bin/ptt-radio-hub"]
